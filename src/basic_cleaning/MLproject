name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Name of artifact downloaded from weights & biases
        type: string

      output_artifact:
        description: Name of artifact created and uploaded to weights & biases

      output_type:
        description: Type of artifact to be uploaded to weights & biases
        type: string

      output_description:
        description: Description of artifact to be uploaded to weights & biases
        type: string

      min_price:
        description: The minimum price to consider when removing outliers
        type: float

      max_price:
        description: The maximum price to consider when removing outliers
        type: float

    command: >-
      python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price}
